import cli.OsStr
import cli.Path
import DocsArchive
import Files
import Html
import Release
import Script

## Assembling the GitHub Pages site: the landing page in `www`, fresh API
## documentation for the working tree, and the archived docs of each release.
Site := [].{

	## Generate the API documentation of the working tree into `output`.
	docs! = |roc, output|
		roc.run!(["docs", "package/main.roc", "--output=${Path.display(output)}"])

	## Assemble the whole site into `output` with `roc`. `releases`
	## says whether to restore archived docs from release assets, which needs
	## network access: `FetchReleaseDocs` or `SkipReleaseDocs`.
	assemble! = |roc, output, releases| {
		prepare_output!(output)?
		Path.copy_dir_with!("www", output, { symlinks: Preserve, destination: Merge })?
		match releases {
			FetchReleaseDocs => DocsArchive.fetch!(output)?
			SkipReleaseDocs => {}
		}

		main_docs = Path.join(output, "main")
		if Path.exists!(main_docs)? {
			Path.delete_all!(main_docs)?
		}
		roc
			.cmd(["docs", "package/main.roc", "--output=${Path.display(main_docs)}"])
			.env_str("ROC_DOCS_URL_ROOT", "${Html.base_path}/main")
			.exec_cmd!()?
		Path.copy!(Path.join(main_docs, "favicon.svg"), Path.join(output, "favicon.svg"))?

		add_examples!(output)?
		enhanced = enhance_pages!(output)?
		add_version_list!(output)?
		Script.info!("SITE", "${Path.display(output)}, with ${enhanced.to_str()} pages rewritten")
	}
}

marker = ".roc-ansi-site"

# Replacing a directory is destructive, so only one this script made is replaced.
prepare_output! = |output| {
	if Path.exists!(output)? {
		if !Path.is_file!(Path.join(output, marker))? {
			return Script.fail!("refusing to replace ${Path.display(output)}: it was not created by this script")
		}
		Path.delete_all!(output)?
	}
	Path.create_all!(output)?
	Path.write_utf8!(Path.join(output, marker), "generated by scripts/build_site.roc\n")
}

add_examples! = |output| {
	assets = Path.join(output, "examples")
	Path.create_all!(assets)?
	for (slug, _) in Html.examples {
		source : Path
		source = "examples/${slug}.roc"
		capture : Path
		capture = "docs/images/${slug}.png"
		if !Path.is_file!(source)? or !Path.is_file!(capture)? {
			return Script.fail!("missing source or terminal capture for the ${slug} example")
		}
		Path.copy!(capture, Path.join(assets, "${slug}.png"))?
	}
	fill_landing!(output, "<!--EXAMPLES-->", Html.example_grid(Html.examples))
}

add_version_list! = |output| {
	entries = Path.list!(output)?
	names = entries.map_try(Script.file_name)?
	fill_landing!(output, "<!--VERSIONS-->", Html.version_list(names.keep_if(Release.valid_docs_version)))
}

fill_landing! = |output, placeholder, content| {
	index = Path.join(output, "index.html")
	match Html.fill(Path.read_utf8!(index)?, placeholder, content) {
		Ok(document) => Path.write_utf8!(index, document)
		Err(MissingPlaceholder(_)) => Script.fail!("${Path.display(index)} is missing ${placeholder}")
	}
}

enhance_pages! : Path => Try(U64, _)
enhance_pages! = |output| {
	root_prefix = "${Path.display(output)}/"
	var $changed = 0
	for page in Files.all_files!(output)?.keep_if(|path| Files.has_ext(path, "html")) {
		document = Path.read_utf8!(page)?
		match Html.enhance(document, Path.display(page).drop_prefix(root_prefix)) {
			Ok(enhanced) if enhanced != document => {
				Path.write_utf8!(page, enhanced)?
				$changed = $changed + 1
			}
			Ok(_) => {}
			Err(IncompletePage) => return Script.fail!("cannot rewrite ${Path.display(page)}: incomplete HTML document")
		}
	}
	Ok($changed)
}
