## GENERATED from Unicode 17.0.0. Run `python3 scripts/unicode_data.py generate`. ##
## layout: 8704 U8 page ids + 164 x 128 U8 values; logical payload 29696 bytes. ##

UnicodeInternalGraphemeData :: [].{
	GCB : [Other, CR, LF, Control, Extend, ZWJ, RI, Prepend, SpacingMark, L, V, T, LV, LVT]
	InCB : [None, Consonant, Extend, Linker]
	Props : { gcb : GCB, incb : InCB, extended_pictographic : Bool }

	lookup : U32 -> Props
	lookup = |scalar| {
		value = if scalar < 128 {
			ascii_value(scalar)
		} else if scalar > 0x10FFFF {
			0
		} else {
			page_id = page_index.get(scalar.shr_wrap(7).to_u64()) ?? 0
			offset = page_id.to_u64() * 128 + scalar.bitwise_and(127).to_u64()
			pages.get(offset) ?? 0
		}

		{
			gcb: gcb_from_u8(value.bitwise_and(0x0F)),
			incb: incb_from_u8(value.shr_wrap(4).bitwise_and(0x03)),
			extended_pictographic: value.bitwise_and(0x40) != 0,
		}
	}
}

ascii_value : U32 -> U8
ascii_value = |u32| if (u32 == 13) (1) else if (u32 == 10) (2) else if ((u32 >= 0 and u32 <= 9) or (u32 >= 11 and u32 <= 12) or (u32 >= 14 and u32 <= 31) or u32 == 127) (3) else 0

gcb_from_u8 : U8 -> UnicodeInternalGraphemeData.GCB
gcb_from_u8 = |value| {
	match value {
		0 => Other
		1 => CR
		2 => LF
		3 => Control
		4 => Extend
		5 => ZWJ
		6 => RI
		7 => Prepend
		8 => SpacingMark
		9 => L
		10 => V
		11 => T
		12 => LV
		13 => LVT
		_ => ...
	}
}

incb_from_u8 : U8 -> UnicodeInternalGraphemeData.InCB
incb_from_u8 = |value| {
	match value {
		0 => None
		1 => Consonant
		2 => Extend
		3 => Linker
		_ => ...
	}
}

